# ---------- Demo mode password ----------
# While Supabase isn't set up there are no logins, so the online site asks for this
# password instead (leave the username blank or type anything). Required on Vercel in demo mode.
SITE_PASSWORD=

# ---------- Core (Supabase) ----------
# Leave these empty to run in DEMO MODE (seeded data, nothing is saved after a restart).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for inviting users and for the connectors to store tokens and sync data.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for OAuth redirect URIs), e.g. https://hq.thecheesecourse.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the scheduled sync endpoint (/api/cron/sync). Any long random string.
CRON_SECRET=

# ---------- Square ----------
SQUARE_APP_ID=
SQUARE_APP_SECRET=
# production or sandbox
SQUARE_ENV=production

# ---------- Meta (Instagram + Facebook) ----------
META_APP_ID=
META_APP_SECRET=

# ---------- Google Business Profile ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- TikTok ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
